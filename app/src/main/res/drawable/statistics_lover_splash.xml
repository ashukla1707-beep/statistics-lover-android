<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Android 12+ masks the splash animated icon to a circular safe area.
      Keep the full Statistics Lover artwork inside that safe area instead of
      letting the outer logo text/ring be cropped.
    -->
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="240dp"
                android:height="240dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

    <item
        android:width="144dp"
        android:height="144dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/statistics_lover_logo"
            android:gravity="fill"
            android:filter="true" />
    </item>
</layer-list>
